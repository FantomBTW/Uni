  align: center + horizon,
  table.header(
    [*J*], [*K*], [*clock*], [*$Q_t$*], [*$Q_{t+1}$*], [*$Q'_{t+1}$*], [*Состояние / Режим*]
  ),
  [y], [y], [0], [x], [ x ], [ x'], [хранение],
